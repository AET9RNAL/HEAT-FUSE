{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach: FUSE runtime sidecar",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "address": "127.0.0.1",
      "restart": true,
      "continueOnAttach": true,
      "sourceMaps": true,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/runtime/**",
        "${workspaceFolder}/plugins-src/**",
        "!**/node_modules/**"
      ]
    }
  ]
}
