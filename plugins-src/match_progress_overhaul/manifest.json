{
  "plugin_id": "match_progress_overhaul",
  "name": "Match Progress Overhaul",
  "version": "2.0.0",
  "author": "AETERNAL",
  "description": "Redesigned match progress bar",
  "entry": "plugin:MatchProgressOverhaulPlugin",
  "runtime": "node",
  "dependencies": { "accessors": ">=5.0.0", "fuse_ui": ">=2.0.0", "canvas_ui": ">=2.0.0" },
  "min_host_version": "5.0.0",
  "permissions": {
    "accessors.ui": { "reason": "Hides the game's own match progress bar when the enhanced one is on." }
  },
  "hotkeys": {},
  "default_config": {
    "vue_overlay_pos": null,
    "vue_width": 620,
    "vue_height": 50,
    "hide_native": true,
    "show_in": ["alive", "dead", "deploy"],
    "ally_color": "#7ABFDFFF",
    "enemy_color": "#FF6D46FF"
  }
}
