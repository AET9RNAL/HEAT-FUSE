{
  "plugin_id": "aeternalsCrosshairs",
  "name": "Aeternal's Crosshairs",
  "version": "1.0.0",
  "author": "AETERNAL",
  "description": "A pack of custom made reticles",
  "entry": "plugin:CrosshairPlugin",
  "runtime": "node",
  "dependencies": { "accessors": ">=5.0.0", "fuse_ui": ">=2.0.0" },
  "min_host_version": "5.0.0",
  "permissions": {
    "accessors.ui": { "reason": "Draws the reticle inside the game's HUD, in place of the game's default aim." },
    "audio": { "reason": "Plays the aimed sound with the reticle ghost." },
    "language": { "reason": "Shows Crosshair in the FUSE App's language until you pick one." }
  },
  "hotkeys": {
    "toggle_manager": "ctrl+alt+x"
  },
  "default_config": {
    "manager_pos": null,
    "locale": "",
    "manager_open": true,
    "in_game": true,
    "reticle": "triangle",
    "show_in": ["alive"],
    "triangle_sides": "clockwise",
    "triangle_bars": true,
    "triangle_color": "#FFFFFFFF",
    "triangle_reload_color": "#FFFFFF80",
    "triangle_center_color": "#FFFFFFFF",
    "triangle_center_stroke_color": "#0A0B0AFF",
    "triangle_bar_color": "#FFFFFFFF",
    "triangle_bar_work_color": "#00000080",
    "triangle_bar_base_color": "#00000080",
    "brackets_sides": "clockwise",
    "brackets_bars": true,
    "brackets_color": "#FFFFFFFF",
    "brackets_reload_color": "#FFFFFF80",
    "brackets_center_color": "#FFFFFFFF",
    "brackets_backdrop_color": "#FFFFFF80",
    "brackets_bar_color": "#FFFFFFFF",
    "brackets_bar_work_color": "#00000080",
    "brackets_bar_base_color": "#00000080",
    "ring_sides": "clockwise",
    "ring_bars": true,
    "ring_color": "#FFFFFFFF",
    "ring_reload_color": "#FFFFFF80",
    "ring_base_color": "#0000004D",
    "ring_rim_color": "#FFFFFFFF",
    "ring_center_color": "#FFFFFFFF",
    "ring_backdrop_color": "#00000080",
    "ring_bar_color": "#FFFFFFFF",
    "ring_bar_work_color": "#00000080",
    "ring_bar_base_color": "#0000004D",
    "ghost_on": "dispersion",
    "aimed_sound": true,
    "aimed_volume": 0.8,
    "color_range_effective": "#71CE71FF",
    "color_range_falloff": "#FFDB8CFF",
    "color_range_out": "#FF6A62FF"
  }
}
