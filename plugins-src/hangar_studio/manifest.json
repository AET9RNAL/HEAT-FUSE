      { "id": "carrier_engine_room_2", "name": "Aircraft Carrier Ship Engine Room 2", "kind": "hangar", "dir": "overrides/carrier_engine_room_2" },
      { "id": "blossom_monument", "name": "Blossom Monument", "kind": "hangar", "dir": "overrides/blossom_monument" },
