{
  "plugin_id": "hud_scoreboard",
  "name": "Hud Scoreboard",
  "version": "2.0.0",
  "author": "AETERNAL",
  "description": "See the Ally and enemy roster without having to TAB every time.",
  "entry": "plugin:HudScoreboardPlugin",
  "runtime": "node",
  "dependencies": { "accessors": ">=5.0.0", "fuse_ui": ">=2.0.0", "canvas_ui": ">=2.0.0" },
  "optional_dependencies": ["heat_stats"],
  "min_host_version": "5.0.0",
  "hotkeys": {},
  "default_config": {
    "vue_overlay_pos": null,
    "vue_width": 1500,
    "vue_height": 90,
    "mirror_enemies": true,
    "show_names": false,
    "show_in": ["alive", "dead", "deploy"],
    "ally_color": "#7ABFDFFF",
    "enemy_color": "#FF6D46FF"
  }
}
