{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@fuse/plugin-sdk": ["../runtime/src/sdk/index.ts"],
      "vue": ["../frontend/fuse/node_modules/vue"],
      "motion-v": ["../frontend/fuse/node_modules/motion-v"],
      "@rive-app/canvas": ["../frontend/fuse/node_modules/@rive-app/canvas"],
      "chart.js": ["../frontend/fuse/node_modules/chart.js"],
      "chart.js/auto": ["../frontend/fuse/node_modules/chart.js/auto"],
      "*": ["./*"]
    },
    "typeRoots": ["../runtime/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.vue", "shims.d.ts"]
}
