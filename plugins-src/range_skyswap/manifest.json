      { "id": "project_phoenix", "name": "Project Phoenix Theme", "kind": "world", "dir": "overrides/project_phoenix", "preview": "preview.webp" },
      { "id": "sunstroke", "name": "Sunstroke Theme", "kind": "world", "dir": "overrides/sunstroke", "preview": "preview.webp" },
      { "id": "vietnam", "name": "Vietnam Theme", "kind": "world", "dir": "overrides/vietnam", "preview": "preview.webp" }
