{
  "plugin_id": "cruise_control",
  "name": "Cruise Control",
  "version": "3.0.0",
  "author": "AETERNAL",
  "description": "Simple cruise control functionality",
  "entry": "plugin:CruiseControlPlugin",
  "runtime": "node",
  "dependencies": { "accessors": ">=5.0.0" },
  "min_host_version": "5.0.0",
  "hotkeys": {
    "toggle": "c"
  },
  "default_config": {
    "overlay_pos": null,
    "anim_width": 300,
    "anim_height": 300,
    "show_in": ["alive", "map"],
    "show_in_hangar": []
  }
}
