{
  "plugin_id": "minimap",
  "name": "Minimap",
  "version": "1.0.0",
  "author": "AETERNAL",
  "description": "Full featured minimap overlay with proximity alerts",
  "entry": "plugin:MinimapPlugin",
  "runtime": "node",
  "dependencies": { "accessors": ">=5.0.0", "fuse_ui": ">=2.0.0" },
  "min_host_version": "5.0.0",
  "permissions": {
    "accessors.ui": { "reason": "Draws the map inside the game's own radar." },
    "audio": { "reason": "Plays a warning tone when the radar finds an enemy outside your view." },
    "language": { "reason": "Shows the minimap in the FUSE App's language until you pick one." }
  },
  "hotkeys": {
    "zoom_out": "shift",
    "mark_here": "ctrl+m"
  },
  "default_config": {
    "locale": "",
    "vue_overlay_pos": null,
    "vue_width": 300,
    "vue_height": 356,
    "show_in": ["alive"],
    "shape": "circle",
    "orientation": "heading",
    "range": 400,
    "zoom_range": 450,
    "map_opacity": 0.9,
    "radar_ring": true,
    "show_safe_cone": true,
    "class_icons": true,
    "hide_game_radar": false,
    "radar_layer": true,
    "radar_layer_opacity": 0.6,
    "radar_layer_scale": "near",
    "warn_enabled": true,
    "warn_cone": 180,
    "warn_range": 300,
    "warn_range_invert": false,
    "point_scale": 2,
    "warn_volume": 0.7,
    "warn_cooldown": 2,
    "warn_missiles": false,
    "color_you": "#FFD85CFF",
    "color_squad": "#78D098FF",
    "color_ally": "#7ABFDFFF",
    "color_enemy": "#FF6D46FF",
    "color_contested": "#FFD85CFF",
    "color_neutral": "#D0CBC4FF",
    "learned_bases": {}
  }
}
